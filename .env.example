# Configuração por variável de ambiente. Segredo nunca no repositório.
# Copie para `.env` e preencha — este arquivo é só a lista, com valores de
# exemplo que não servem para nada em produção.

# --- Banco -------------------------------------------------------------------

# Role restrito da aplicação: NOBYPASSRLS, sem DDL. É por ele que a API fala com
# o banco, e é o que faz a RLS ser exercida de verdade.
DATABASE_URL="postgres://barbearia_app:TROQUE@127.0.0.1:5432/barbearia"

# Superusuário. Só para migração e para semear teste — nunca para a aplicação.
ADMIN_DATABASE_URL="postgres://postgres@127.0.0.1:5432/postgres"

# Senha do role da aplicação, usada por `scripts/bootstrap-role.sh`.
APP_DB_PASSWORD="TROQUE"

# --- Identidade --------------------------------------------------------------

# Segredo do HMAC que indexa e-mail de gestor em `staff_directory`.
#
# Obrigatória. A aplicação **falha alto** sem ela, de propósito: cair num padrão
# fraco deixaria a tabela virar a lista de donos de barbearia da plataforma em
# claro, e ninguém perceberia.
#
# Trocar este valor torna o login por e-mail impossível para quem já tem conta —
# as chaves antigas deixam de bater. Rotacionar exige recalcular a tabela.
STAFF_EMAIL_PEPPER="gere-com-openssl-rand-hex-32"

# Assina o carimbo de "veio pela busca do marketplace" (bloco 72). Sem ela, a
# origem do agendamento é forjável por quem manda a requisição — e é a origem
# que decide a comissão sobre cliente novo. Falha alto quando ausente.
MARKETPLACE_ORIGIN_SECRET="gere-com-openssl-rand-hex-32"

# --- API ---------------------------------------------------------------------

PORT="3000"

# Limites do throttler. Os defaults valem para produção; o teste funcional os
# afrouxa porque dispara centenas de requisições do mesmo IP.
# RATE_LIMIT_SHORT="20"
# RATE_LIMIT_LONG="200"

# --- Web ---------------------------------------------------------------------

# Onde o SSR encontra a API. Servidor para servidor, não passa pelo navegador.
API_URL="http://127.0.0.1:3000"

# Onde o produto está no ar, para compor link em mensagem (convite de vaga,
# pedido de avaliação, link da nota). Sem ela o link sai apontando para o
# laço, e a pessoa recebe um endereço que não abre.
WEB_URL="http://127.0.0.1:3001"

# --- Chaves de cifra: uma por finalidade, e nenhuma opcional ------------------
#
# Todas falham alto quando ausentes. É decisão, e o motivo é o mesmo em todas:
# cair num padrão fraco em silêncio deixaria segredo em repouso sem que ninguém
# percebesse — e o sintoma só aparece no vazamento.
#
# **Uma por finalidade, e não uma só.** Girar a chave do segundo fator é
# operação normal de segurança; com uma chave compartilhada, girá-la deixaria
# ilegível o token de WhatsApp de todas as barbearias ao mesmo tempo, e o
# defeito apareceria como "a mensagem parou de sair" dias depois.

# AES-256-GCM do segredo TOTP do gestor.
MFA_SECRET_KEY="gere-com-openssl-rand-base64-32"

# HMAC do segredo das chaves de API (bloco 78). HMAC e não scrypt: chave de API
# é 256 bits sorteados e conferidos a cada requisição, e derivar caro seria o
# teto de vazão da integração.
API_KEY_PEPPER="gere-com-openssl-rand-hex-32"

# AES-256-GCM do segredo com que **nós** assinamos a saída de webhook (bloco 79).
# Cifrado e recuperável, ao contrário da chave de API — a diferença é a direção:
# lá quem apresenta o segredo é o outro lado; aqui quem assina somos nós.
WEBHOOK_SECRET_KEY="gere-com-openssl-rand-base64-32"

# AES-256-GCM do token da Cloud API de cada barbearia (bloco 55).
WHATSAPP_TOKEN_KEY="gere-com-openssl-rand-base64-32"

# O canal de mensagem **deste processo** (bloco 82).
#
# A credencial é por barbearia e mora no banco — o cadastro preenchido já é a
# decisão de mandar. O que esta variável decide é outra coisa: se este processo
# fala com a internet. Sem ela, um dump de produção restaurado num notebook
# começaria a mandar promoção para a base de clientes de verdade no primeiro
# `pnpm dev`, e ninguém teria decidido isso.
#
# `nenhum` mantém tudo saindo pelo canal de reserva, que hoje é o log. Valor
# desconhecido **falha alto**: lido com tolerância, `cloud` viraria "desligado" e
# a barbearia descobriria pelo cliente que o lembrete não chega.
WHATSAPP_MODO="nenhum"     # nenhum | meta

# O app da plataforma na Meta, para o Embedded Signup (bloco 83).
#
# Ao contrário do token de acesso — que é de cada barbearia e mora cifrado em
# `whatsapp_settings` —, estes três são do **nosso** app, um par para todas. É
# por eles que a Meta sabe que o código de autorização foi emitido para nós.
#
# Vazios, o produto opera sem conexão automática: a tela não desenha o botão e
# o formulário do bloco 55 continua sendo o caminho. Botão que abre janela
# vazia é pior que botão nenhum.
#
# `META_APP_ID` e `META_CONFIG_ID` são públicos por desenho — os dois vão dentro
# do JavaScript que roda no navegador de quem se cadastra. `META_APP_SECRET`
# **não**: ele assina em nome do app inteiro e nunca sai do servidor.
META_APP_ID=""
META_CONFIG_ID=""
META_APP_SECRET=""

# Qual fluxo a janela de conexão abre (bloco 85).
#
# `padrao` conecta um número novo, e ele **sai** do aplicativo WhatsApp: passa a
# ser da Cloud API e deixa de funcionar lá. É o comportamento anterior, e é o
# padrão de fábrica pela mesma regra de `PSP_MODO` e `FISCAL_MODO`.
#
# `coexistencia` conecta um número que a barbearia **já usa no aplicativo
# WhatsApp Business**, e ele continua funcionando lá — a Meta mantém as
# conversas em dia entre os dois. Exige status de Solution Partner ou Tech
# Provider **vinculado a este app**: ter o status noutro negócio não habilita
# este `META_CONFIG_ID`, e isso não dá para conferir de dentro do código.
#
# Valor desconhecido **falha alto**: lido com tolerância, um erro de digitação
# abriria o fluxo que toma o número da barbearia.
WHATSAPP_ONBOARDING="padrao"   # padrao | coexistencia

# --- Adquirente ---------------------------------------------------------------
#
# `nenhum` é o padrão e o modo do bloco 28: nada é debitado sozinho, e quem
# quita fatura é o Super Admin registrando o que viu no extrato. Valor
# desconhecido **falha alto** — lido com tolerância, um erro de digitação
# viraria "sem adquirente" e a plataforma pararia de cobrar por um ciclo inteiro
# de faturamento sem ninguém perceber.
PSP_MODO="nenhum"          # nenhum | fake | stripe

# Só com PSP_MODO=stripe.
# STRIPE_SECRET_KEY="sk_test_..."
# Segredo **próprio** do endereço: a Stripe gera um por endpoint.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Webhook do adquirente genérico. Segredo ausente **recusa** a entrega — nunca
# processa sem conferir a assinatura.
# PSP_WEBHOOK_SECRET="gere-com-openssl-rand-hex-32"

# --- Fiscal -------------------------------------------------------------------
#
# `nenhum` é o padrão, e com ele a tela **diz** que a emissão não está ligada.
# Não existe emissor de verdade integrado: `fake` serve para exercitar a cadeia
# em teste, e em produção ele faria a nota ficar em "processando" para sempre.
FISCAL_MODO="nenhum"       # nenhum | fake

# --- WhatsApp (Cloud API) -----------------------------------------------------
#
# O número é o **da barbearia**, verificado na Meta — nunca o da plataforma. O
# que mora aqui é o segredo da própria aplicação Meta, que é uma só.

# Assina o corpo cru do webhook. A Meta não manda instante, então não há janela
# de tempo: quem substitui é a idempotência por id de mensagem.
# WHATSAPP_APP_SECRET="..."
# Token do handshake de verificação do endereço.
# WHATSAPP_VERIFY_TOKEN="gere-com-openssl-rand-hex-32"

# --- Worker -------------------------------------------------------------------

# Intervalo da volta do laço. O padrão serve; baixá-lo aumenta a pressão no
# banco sem entregar nada, porque as tarefas já são agendadas por instante.
# WORKER_INTERVALO_MS="5000"

# --- Observabilidade ----------------------------------------------------------

# Uma linha por requisição. `nao` em suíte de teste, onde ela enterraria a
# mensagem do teste que falhou.
# LOG_REQUISICOES="sim"
