{
  "name": "@barbearia/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "//postinstall": "O cliente do Prisma é gerado, nunca versionado (packages/db/prisma/generated fica no .gitignore). Sem isto, um clone novo falha no primeiro build com \"Module '@prisma/client' has no exported member 'PrismaClient'\" — erro que parece dependência quebrada e é geração que faltou. Achado ao testar o zip numa pasta limpa.",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "db:pull": "prisma db pull --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "migrate": "./scripts/migrate.sh",
    "test": "./scripts/test.sh",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}